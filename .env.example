# ---------------------------------------------------------------------------
# AxiomRisk — environment variables
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is gitignored; `.env.example` is committed as the template.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# ---------------------------------------------------------------------------

# Web3Forms access key for the /contact form.
# Get a free key at https://web3forms.com — enter your inbox address and the
# key is emailed to you. This key is public by design (it only permits
# submissions to your own inbox), so it is safe in a client bundle.
# Without it, the contact form will show its error fallback on submit.
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here
